<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Winche.Core.AspNetCore</PackageId>
    <RootNamespace>Winche.Core.AspNetCore</RootNamespace>
    <PackageDescription>Winche.Core for ASP.NET Core: who is calling (the request's claims, set once for every Winche package), and the shared error answer and endpoint filter.</PackageDescription>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Winche.Core\Winche.Core.csproj" />
  </ItemGroup>

</Project>
